<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration.
    SleepBT disallows all cleartext HTTP traffic. Only secure TLS connections
    are permitted for crash diagnostics (Crashlytics), optional anonymous install
    metrics, and periodic GitHub update checks.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
