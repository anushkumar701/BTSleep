rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated anonymous users can only write minimal metadata to their own document
    match /users/{userId} {
      allow read: if false;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly(['appVersion', 'lastActiveAt', 'createdAt'])
                   && request.resource.data.appVersion is string
                   && request.resource.data.appVersion.size() <= 16
                   && (!('lastActiveAt' in request.resource.data) || request.resource.data.lastActiveAt is timestamp)
                   && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp);
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
